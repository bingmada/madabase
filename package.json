{
  "name": "madabase",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.x"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:main": "npm run dev --workspace apps/main",
    "dev": "npm run dev --workspace apps/web",
    "dev:test": "npm run dev --workspace apps/test",
    "dev:affiliate": "npm run dev --workspace apps/affiliate",
    "dev:affiliate:pet": "npm run dev:pet --workspace apps/affiliate",
    "dev:affiliate:homeoffice": "npm run dev:homeoffice --workspace apps/affiliate",
    "dev:affiliate:baby": "npm run dev:baby --workspace apps/affiliate",
    "dev:affiliate:network": "npm run dev:network --workspace apps/affiliate",
    "dev:affiliate:costume": "npm run dev:costume --workspace apps/affiliate",
    "dev:wellness": "npm run dev --workspace apps/wellness",
    "build:main": "npm run build --workspace apps/main",
    "build": "npm run build --workspace apps/web",
    "build:test": "npm run build --workspace apps/test",
    "build:affiliate": "npm run build --workspace apps/affiliate",
    "build:release:main": "npm run build:release --workspace apps/main",
    "build:release:web": "npm run build:release --workspace apps/web",
    "build:release:test": "npm run build:release --workspace apps/test",
    "build:release:affiliate": "npm run build:release --workspace apps/affiliate",
    "build:release:wellness": "npm run build:release --workspace apps/wellness",
    "build:release:all": "npm run build:release:main && npm run build:release:web && npm run build:release:test && npm run build:release:affiliate && npm run build:release:wellness",
    "build:affiliate:pet": "npm run build:pet --workspace apps/affiliate",
    "build:affiliate:homeoffice": "npm run build:homeoffice --workspace apps/affiliate",
    "build:affiliate:baby": "npm run build:baby --workspace apps/affiliate",
    "build:affiliate:network": "npm run build:network --workspace apps/affiliate",
    "build:affiliate:costume": "npm run build:costume --workspace apps/affiliate",
    "build:wellness": "npm run build --workspace apps/wellness",
    "start:main": "npm run start --workspace apps/main",
    "start": "npm run start --workspace apps/web",
    "start:test": "npm run start --workspace apps/test",
    "start:affiliate": "npm run start --workspace apps/affiliate",
    "start:affiliate:pet": "npm run start:pet --workspace apps/affiliate",
    "start:affiliate:homeoffice": "npm run start:homeoffice --workspace apps/affiliate",
    "start:affiliate:baby": "npm run start:baby --workspace apps/affiliate",
    "start:affiliate:network": "npm run start:network --workspace apps/affiliate",
    "start:affiliate:costume": "npm run start:costume --workspace apps/affiliate",
    "start:wellness": "npm run start --workspace apps/wellness",
    "lint:main": "npm run lint --workspace apps/main",
    "lint": "npm run lint --workspace apps/web",
    "lint:test": "npm run lint --workspace apps/test",
    "lint:affiliate": "npm run lint --workspace apps/affiliate",
    "lint:wellness": "npm run lint --workspace apps/wellness",
    "sync:affiliate:amazon": "npm run sync:amazon --workspace apps/affiliate",
    "test": "npm run test --workspace apps/web",
    "db:generate": "npm exec --workspace apps/web prisma generate -- --schema ../../prisma/schema.prisma"
  }
}
