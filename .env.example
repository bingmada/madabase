DATABASE_URL=postgresql://postgres:postgres@localhost:5432/madabase
NEXT_PUBLIC_SITE_URL=https://madabase.com
NEXT_PUBLIC_TEST_SITE_URL=https://test.madabase.com
NEXT_PUBLIC_MAIN_SITE_URL=https://madabase.com
AUTH_COOKIE_DOMAIN=.madabase.com
AUTH_EMAIL_PROVIDER=resend
AUTH_EMAIL_FROM=Madabase <noreply@madabase.com>
RESEND_API_KEY=re_your_resend_api_key

# Amazon Creators API. Keep real credential values out of Git and client code.
AMAZON_CREATORS_CREDENTIAL_ID=credential_id_from_associates_central
AMAZON_CREATORS_CREDENTIAL_SECRET=credential_secret_from_associates_central
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_CREATORS_ASIN_MAP_PATH=apps/affiliate/config/amazon-market-asins.json
# A valid store or tracking ID from each requested marketplace is required.
AMAZON_CREATORS_PARTNER_TAG_GB=uk_store_or_tracking_id
AMAZON_CREATORS_PARTNER_TAG_CA=canada_store_or_tracking_id
AMAZON_CREATORS_PARTNER_TAG_DE=germany_store_or_tracking_id
AMAZON_CREATORS_PARTNER_TAG_NL=netherlands_store_or_tracking_id
# Optional site-specific form:
# AMAZON_CREATORS_PARTNER_TAG_GB_NETWORK=uk_network_tracking_id

# Costume / CJ secrets and runtime configuration. Keep real values out of Git.
CJ_COSTUME_PID=101838067
CJ_PRODUCT_EXPORT_SUBSCRIPTION_ID=319553
CJ_PRODUCT_EXPORT_PATH=/secure/path/to/cj-product-export.zip
CJ_PRODUCT_EXPORT_FILENAME=Abracadabra_NYC-Shopify_Feed_via_ExportFeed-shopping.txt.zip
CJ_SYNC_LIMIT=1000
CJ_API_TOKEN=cj_personal_access_token
CJ_COMMISSION_GRAPHQL_ENDPOINT=https://commissions.api.cj.com/query
CJ_COMMISSION_QUERY_PATH=apps/affiliate/config/cj-commission-detail.graphql
CJ_COMMISSION_QUERY_VARIABLES={"publisherIds":["8000508"],"advertiserIds":["7889430"],"websiteIds":["101838067"],"sincePostingDate":"2026-07-01T00:00:00Z"}
CJ_SFTP_HOST=datatransfer.cj.com
CJ_SFTP_PORT=22
CJ_SFTP_USERNAME=sftp_username_from_cj_email
CJ_SFTP_PASSWORD=sftp_password_from_cj_email
CJ_SFTP_HOST_KEY_SHA256=sha256_fingerprint_from_an_authoritative_cj_source
# Keep disabled. A temporary 1 must be scoped to one command only while CJ's legacy host remains in service.
CJ_SFTP_ALLOW_LEGACY_DSA=0
